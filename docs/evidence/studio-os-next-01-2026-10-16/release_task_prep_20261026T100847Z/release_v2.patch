+def _drop(answer: str, section: str, empty: bool = False) -> str:
+    """Убрать раздел целиком (или оставить заголовок с пустым телом)."""
+    parts = answer.split("## ")
+    keep = []
+    for part in parts:
+        if part.startswith(section + "\n"):
+            if empty:
+                keep.append(section + "\n\n")
+            continue
+        keep.append(part)
+    return "## ".join(keep)
+
