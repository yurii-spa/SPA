+    assert info["blobs"] == 2
+    for f in (src / "blobs").iterdir():
+        d = tmp_path / "dst" / "blobs" / f.name
+        assert d.read_bytes() == f.read_bytes() and os.stat(d).st_ino != os.stat(f).st_ino
+        assert os.stat(f).st_nlink == 1, "источник получил жёсткую ссылку"
