+    except (ReviewError, ConfigError) as exc:
+        print(f"PREPARATION NOT BUILT: {exc}")
+        return 2
+    st = res["state"]
+    print(f"{res['action']} · state {st['state']} · form {st.get('form')} → {res['run']}")
+    return 0 if st["state"] == "current" else 1
