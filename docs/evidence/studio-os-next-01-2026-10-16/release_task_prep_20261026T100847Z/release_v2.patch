+
+def _mutating_adapter(s, mutate):
+    fx = ad.fixture({"*": _answer()})
+
+    def run(req, **kw):
+        s.calls.append(req.task_id)
+        mutate()
+        return fx(req, **kw)
+    return {"fixture": run}
