        "DERIVED"
       ]
      }
     }
    }
   }
  },
  "decisions": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "topic",
     "title",
     "cls",
     "declared",
     "basis",
     "refs",
     "note"
    ],
    "properties": {
     "cls": {
      "type": "string",
      "enum": [
       "CURRENT",
       "SUPERSEDED",
       "REJECTED",
       "EXPERIMENTAL",
       "UNKNOWN"
      ]
     },
     "refs": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "adr",
        "path",
        "status",
        "effective",
        "superseded_by"
       ]
      }
     }
    }
   }
  },
  "intents": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "intent_id",
     "title",
     "decisions",
     "decision_status",
     "flags",
     "curated_status",
     "last_verified"
    ],
    "properties": {
     "intent_id": {
      "type": "string",
      "pattern": "^INT-\\d+$"
     },
     "decision_status": {
      "type": "string",
      "enum": [
       "DECISIONS_CURRENT",
       "SUPERSEDED_DECISION",
       "UNKNOWN"
      ]
     }
    }
   }
  },
  "profiles": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "profile",
     "internal_book",
     "track_source",
     "decision",
     "effective",
     "metric_type",
     "runtime_state",
     "value",
     "reportable"
    ],
    "properties": {
     "metric_type": {
      "type": "string",
      "enum": [
       "TARGET_RETURN",
       "OBSERVED_RETURN",
       "REALIZED_PAPER_RETURN",
       "MODELLED_RETURN",
       "BACKTEST_RETURN"
      ]
     }
    }
   }
  }
 }
}
