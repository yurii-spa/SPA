{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "spa:docs/continuity/CURRENT_STATE.schema.json",
 "title": "ARB continuity state (arb-continuity/2, ADR-610) — the machine twin of the generated CURRENT_STATE.md",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "header",
  "inputs",
  "runtime",
  "sections",
  "decisions",
  "intents",
  "profiles"
 ],
 "properties": {
  "header": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "context_version",
    "generated_at",
    "repo_commit",
    "origin_commit",
    "production_release",
    "latest_accepted_epic",
    "source_snapshot_ids",
    "generator_version",
    "authority",
    "runtime_truth_computed_at",
    "production_release_verified_at",
    "copy_role",
    "verdict_at_generation",
    "root_dirty_inputs"
   ],
   "properties": {
    "context_version": {
     "type": "string",
     "enum": [
      "arb-continuity/2"
     ]
    },
    "generated_at": {
     "type": "string",
     "pattern": "^20\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "repo_commit": {
     "type": "string",
     "pattern": "^([0-9a-f]{40}|UNKNOWN)$"
    },
    "origin_commit": {
     "type": "string",
     "pattern": "^([0-9a-f]{40}|UNKNOWN)$"
    },
    "production_release": {
     "type": "string",
     "pattern": "^([0-9a-f]{40}|UNKNOWN)$"
    },
    "latest_accepted_epic": {
     "type": "string"
    },
    "source_snapshot_ids": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "pattern": "^(inputs|receipt|mission):[0-9a-f]{64}$"
     }
    },
    "generator_version": {
     "type": "string",
     "pattern": "^arb-continuity/2\\+[0-9a-f]{12}$"
    },
    "authority": {
     "type": "string",
     "enum": [
      "DERIVED"
     ]
    },
    "runtime_truth_computed_at": {
     "type": [
      "string",
      "null"
     ]
    },
    "production_release_verified_at": {
     "type": [
      "string",
      "null"
     ]
    },
    "copy_role": {
     "type": "string",
     "enum": [
      "PRODUCTION",
      "COMMITTED_SNAPSHOT"
     ]
    },
    "verdict_at_generation": {
     "type": "string",
     "enum": [
      "CONTEXT_FRESH",
      "CONTEXT_PARTIAL"
     ]
    },
    "root_dirty_inputs": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "inputs": {
   "type": "object",
   "additionalProperties": {
    "type": "string",
    "pattern": "^[0-9a-f]{64}$"
   }
  },
  "runtime": {
   "type": "object",
   "required": [
    "receipt",
    "mission"
   ]
  },
  "sections": {
