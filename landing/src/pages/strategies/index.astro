---
// PRODUCT-UX-01 candidate: the three profiles compared with identical rows (components/ux/ProfileCompare).
import Layout from '../../layouts/Layout.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import UxStyles from '../../components/ux/UxStyles.astro';
import ProfileCompare from '../../components/ux/ProfileCompare.astro';
import NumberTypes from '../../components/ux/NumberTypes.astro';
import { GO_LIVE, maturitySentence } from '../../lib/profile_view.js';
const ms = maturitySentence();
import '../../lib/realized_rate.js';
---
<Layout title="Strategies — Conservative, Balanced, Aggressive compared | Earn DeFi"
        description="Three stablecoin strategies on paper, compared row by row: who each is for, what is measured, what is only a research target, the risks and the status.">
  <UxStyles />
  <main id="main-content">
    <section class="ux-section">
      <div class="ux-wrap">
        <p class="ux-eyebrow" data-ru="Стратегии">Strategies</p>
        <h1 class="ux-h1" data-ru="Три стратегии — одинаковые вопросы к каждой">Three strategies — the same questions for each</h1>
        <p class="ux-lead" data-ru={ms.ru}>{ms.en}</p>
        <ProfileCompare />
        <p class="ux-small" style="margin-top:14px" data-ru={GO_LIVE.ru}>{GO_LIVE.en}</p>
      </div>
    </section>
    <section class="ux-section">
      <div class="ux-wrap">
        <h2 class="ux-h2" data-ru="Как читать цифры">How to read the numbers</h2>
        <NumberTypes />
      </div>
    </section>
    <div class="ux-wrap" style="padding-bottom:32px"><Disclaimer /></div>
  </main>
</Layout>
