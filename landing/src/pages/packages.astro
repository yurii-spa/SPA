---
import Layout from '../layouts/Layout.astro';
import Disclaimer from '../components/Disclaimer.astro';
import TrustBand from '../components/TrustBand.astro';
import PackageStatusRows from '../components/PackageStatusRows.astro';
import snap from '../lib/snapshot_view.js';
// ВИТРИНА (ADR-365) — единственный адрес чисел. Снимок выше остаётся только для
// полей, которые на витрину ещё не перенесены; новые числа берутся отсюда.
import { book as shelfBook, value as shelfValue } from '../lib/site_numbers.js';
// #7 single band source — the canonical tier name + APY/drawdown band strings live in ONE place so
// /packages, the SiteHeader nav and the index fallback can never diverge (the old SiteHeader 6–8% vs
// /packages 2–6% bug). Rich per-tier copy (what/caveat/status) stays inline; band/name/tone/live come
// from the shared source below.
import BANDS from '../lib/tier_bands.json';
import { realizedPhrase as realizedPhraseRR, realizedApyLabel as realizedLabelRR, measuredNote as measuredNoteRR } from '../lib/realized_rate.js';
// ADR-292 / P0-4 (одобрено владельцем 2026-10-01): ставка — из витрины, с датой замера, не литерал.
const rrEn = realizedLabelRR(null);           // «4.9%» / «data unavailable»
const rrRu = realizedLabelRR(null, true);     // «4,9%» / «нет данных»
const rrNoteEn = measuredNoteRR(false);       // « (measured 2026-10-01)»
const rrNoteRu = measuredNoteRR(true);
const realizedEn = realizedPhraseRR(null);    // «~4.9% realized (measured …)»
const realizedRu = realizedPhraseRR(null, true);

// Honest yield-package tiers. The framework is evaluator.PACKAGES (Conservative / Balanced /
// Aggressive by NET APY + drawdown limit); a package is only offered when its strategies pass the
// DSR gate on REAL data. The honesty is in the STATUS of each tier, not a marketing number:
//   • Conservative  = up to 6% target; the REAL live paper book (~3.3% realized so far, evidenced) — what the desk delivers.
//   • Balanced      = research/paper, WITH the tail, NOT yet trustworthy (thin forward track).
//   • Aggressive    = research/paper, REFUSED for live — brutal tail, shown transparently.
// NOTE: the Conservative LIVE badge is deliberately a TEXT chip ("LIVE · evidenced"), NOT a number.
// The volatile single-day paper_apy_pct (swings 3.2–8.5%) is intentionally NOT rendered here — it
// contradicted the "up to 6% / ~3.3% realized" framing (backlog UX-14). Do not re-add it as a badge.

const tiers = [
  {
    key: 'conservative',
    en: 'Conservative', ru: 'Консервативный',
    status_en: 'PAPER · evidenced track', status_ru: 'PAPER · подтверждённый трек',
    tone: 'green',
    live: true,
    what_en: 'T1/T2 stablecoin lending — Aave, Compound, Morpho, Spark. Deterministic RiskPolicy gate, ≥$5M TVL floor, per-protocol caps. This is the book the desk actually runs on paper today.',
    what_ru: 'T1/T2 стейбл-кредитование — Aave, Compound, Morpho, Spark. Детерминированный гейт RiskPolicy, порог TVL ≥$5M, cap\'ы на протокол. Это книга, которую деск реально ведёт на бумаге сегодня.',
    caveat_en: 'The real, evidenced number. No leverage, no tail-compensation yield. This is what "safe" honestly means here.',
    caveat_ru: 'Реальное, подтверждённое число. Без плеча, без yield-компенсации за хвост. Это и есть честный смысл слова «безопасно» здесь.',
  },
  {
    key: 'balanced',
    en: 'Balanced', ru: 'Сбалансированный',
    // OWNER 2026-08-19 (card owner-decision-sbalansirovannyi-tir-na-saite-idet-paper, variant 1):
    // "paper track running" REMOVED until the Balanced book actually holds positions. Measured (#208):
    // equity > 0 since 09.08, but positions_count == 0 in every one of 45/46 rows — hy_cycle accrues the
    // band's average rate on the whole sum whether or not anything is held. An accrual is not a track.
    // Re-add ONLY on the day positions_count > 0 is measured — that is a fact, not an advance.
    status_en: 'RESEARCH · not live-allocated', status_ru: 'ИССЛЕДОВАНИЕ · без live-аллокации',
    tone: 'amber',
    live: false,
    what_en: 'The Balanced paper book combines floating stablecoin supply with a fixed-rate part: Pendle principal tokens (today PT-sUSDS) bought at a discount and held to maturity, up to 40% of the book and 25% per market. The fixed rate is locked at purchase. No leverage.',
    what_ru: 'Бумажная книга Balanced сочетает плавающее кредитование стейблкоинов с фиксированной частью: принципал-токены Pendle (сейчас PT-sUSDS), купленные с дисконтом и удерживаемые до погашения, — до 40% книги и до 25% на один рынок. Ставка фиксируется при покупке. Без плеча.',
    caveat_en: 'Our engine already found this — and its tail. It stays in paper until it clears 30 forward days + a real vol event; that discipline IS the product. Real in the good months, measured in the bad. Join early-access to get in the day it clears.',
    caveat_ru: 'Наш движок уже нашёл это — и его хвост. Оно остаётся на бумаге, пока не пройдёт 30 форвардных дней и реальное событие волатильности; эта дисциплина И ЕСТЬ продукт. Реально в хорошие месяцы, измерено в плохие. Вступи в ранний доступ, чтобы войти в день, когда оно пройдёт.',
  },
  {
    key: 'aggressive',
    en: 'Aggressive', ru: 'Агрессивный',
    status_en: 'RESEARCH · simulated loop experiment · refused for live (by design)', status_ru: 'ИССЛЕДОВАНИЕ · эксперимент с симулированной петлёй · реальный капитал не допускается (осознанно)',
    tone: 'red',
    live: false,
    what_en: 'The Aggressive paper book holds concentrated stablecoin lending and runs a separate PAPER experiment: a simulated sUSDe-collateral / PYUSD-debt loop on one Morpho Blue market, modelled from that market\u2019s own data (oracle price, debt rate, liquidation threshold, health factor). The loop enters only when its carry beats its costs; until then it holds. No real borrowing, no keys, no transactions.',
    what_ru: 'Бумажная книга Aggressive держит концентрированное кредитование стейблкоинов и ведёт отдельный бумажный эксперимент: симулированную петлю «залог sUSDe — долг PYUSD» на одном рынке Morpho Blue, смоделированную по данным самого рынка (цена оракула, ставка долга, порог ликвидации, коэффициент здоровья). Петля входит, только когда доходность перекрывает издержки; до тех пор — удержание. Реальных займов, ключей и транзакций нет.',
    caveat_en: 'This is the 12–20% advertised elsewhere as "yield". Our engine found it AND its ~50% tail — so it REFUSES live capital until it is proven. That refusal is what you are buying: nobody else publishes what they will not touch. Want the validation report first?',
    caveat_ru: 'Это те 12–20%, что рекламируются в других местах как «доходность». Наш движок нашёл их И их ~50% хвост — поэтому ОТКАЗЫВАЕТ для live-капитала, пока они не доказаны. Этот отказ и есть то, что вы покупаете: никто больше не публикует то, чего не трогает. Хотите первым получить отчёт о валидации?',
  },
];

// #7: the shared source is AUTHORITATIVE for name + band + tone + live — overwrite the inline values so
// a band string only ever exists once (here it's kept inline for diff-locality, but reconciled to BANDS).
// #33: also pull the evidence-level tag + the measured TAIL line so every card server-renders a real
// worst-drawdown figure — never "—" at first paint. Conservative's tail is the REALIZED dd from the live
// snapshot (dynamic); Balanced/Aggressive have no live track yet so they show the measured BACKTEST worst
// (evidence-tagged L2), never a fabricated realized number.
const snapPkg = (snap && snap.packages) || {};
// ADR-103 (owner mandate 2026-08-21): live paper-track line per tier, FACT-GATED by the
// owner's 2026-08-19 rule — rendered ONLY when the book actually holds positions
// (status === 'paper_test_running', i.e. positions_count > 0 was MEASURED, never assumed).
// APY here is computed over positions-held bars only (phantom accrual bars excluded, #208).
const paperTracks = (snap && snap.paper_tracks) || {};
for (const t of tiers) {
  const b = BANDS[t.key];
  if (b) {
    t.en = b.en; t.ru = b.ru; t.band_en = b.band_en; t.band_ru = b.band_ru; t.tone = b.tone; t.live = b.live;
    t.evidence_en = b.evidence_en; t.evidence_ru = b.evidence_ru;
    const dd = snapPkg[t.key] && snapPkg[t.key].dd_pct;
    if (t.key === 'conservative' && typeof dd === 'number') {
      t.tail_en = `Worst drawdown: ${dd.toFixed(1)}% realized to date (paper track)`;
      t.tail_ru = `Макс. просадка: ${dd.toFixed(1)}% реализованная на сегодня (бумажный трек)`;
    } else {
      t.tail_en = b.tail_en; t.tail_ru = b.tail_ru;
    }
  }
  const pt = paperTracks[t.key];
  // ADR-531 / owner Option A: only days of the corrected cost model (sleeve-econ-v2) are published;
  // the earlier period is labelled — never shown as a number, never merged with the new one.
  if (pt && pt.pre_fix_period && !t.live) {
    t.prefix_en = `${pt.pre_fix_period.label_en} (${pt.pre_fix_period.days} days)`;
    t.prefix_ru = `${pt.pre_fix_period.label_ru} (${pt.pre_fix_period.days} дн.)`;
  }
  // ADR-537: the operating status, version, last run and data state are rendered by
  // PackageStatusRows from the one status record — not assembled here a second time.
  if (pt && pt.status === 'paper_test_running' && !t.live) {
    // ДОЛЯ ДНЕЙ, НАЧИСЛЕННЫХ ПО НЕНАБЛЮДЁННЫМ СТАВКАМ (ADR-365, обязательство ADR-357 п. 4).
    //
    // Владелец решил оставить публичный трек этих книг с 23 августа. Решение его; вместе с
    // ним идёт требование инварианта #8: у Aggressive число почти целиком сложено из дней,
    // начисленных по ставкам, которых никто не наблюдал, и без этой строки оно читается как
    // заработанное. Текст приходит с витрины ИЗМЕРЕННЫМ (дата перехода взята из журнала
    // рукава), а не вписан сюда числом — иначе он перестал бы быть правдой молча.
    const split = (shelfBook(t.key) || {}).evidence_split || {};
    if (split.caveat) {
      t.caveat_ru = split.caveat;
      t.caveat_en = `${split.literal_days} of ${split.literal_days + split.observed_days} days accrued on rates nobody observed (before ${split.observed_since})`;
    } else if (split.unmeasured_reason) {
      // Третий исход: долю НЕ ИЗМЕРИЛИ. Молчать нельзя — молчание читается как «литералов нет».
      t.caveat_ru = 'доля дней по ненаблюдённым ставкам не измерена';
      t.caveat_en = 'share of days accrued on unobserved rates is not measured';
    }
  }
}

const toneMap = {
  green: { border: 'border-emerald-500/40', bg: 'bg-emerald-500/5', badge: 'bg-emerald-500/15 text-emerald-300', dot: 'bg-emerald-400' },
  amber: { border: 'border-amber-500/40', bg: 'bg-amber-500/5', badge: 'bg-amber-500/15 text-amber-300', dot: 'bg-amber-400' },
  red:   { border: 'border-rose-500/40', bg: 'bg-rose-500/5', badge: 'bg-rose-500/15 text-rose-300', dot: 'bg-rose-400' },
};
---
<Layout
  title="Yield packages — honest tiers | earn-defi.com"
  description={`Three paper portfolios with different mechanics: unlevered stablecoin lending (Conservative, ~${rrEn} realized paper result so far${rrNoteEn}), a Pendle PT fixed rate (Balanced) and a simulated loop on Morpho Blue (Aggressive). Status and results of the current versions; research targets are not results. Balanced and Aggressive are refused for live capital. No real capital.`}
>
  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-20">
    <section class="pb-8">
      <div class="inline-flex items-center gap-2 mb-5 px-3 py-1.5 rounded-full bg-teal-bg border border-teal-border text-xs text-data-teal font-medium">
        <span class="w-1.5 h-1.5 rounded-full bg-data-teal animate-pulse" aria-hidden="true"></span>
        <span data-ru="Продуктовые тиры — честно">Product tiers — honest</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4" data-ru="Доходные пакеты">Yield packages</h1>
      <p class="text-lg text-slate-400 leading-relaxed max-w-3xl" data-ru="Три бумажных портфеля с разной механикой: кредитование без плеча, кредитование с фиксированной ставкой Pendle PT и кредитование с симулированной петлёй. У каждого — свой статус работы, свои данные, своё решение по позиции и своя статистика текущей версии. Зелёный статус значит «процесс работает и данные свежие» — это не оценка риска и не допуск к реальным деньгам.">
        Three paper portfolios with different mechanics: unlevered lending, lending with a Pendle PT fixed rate, and lending with a simulated loop. Each has its own operating status, data, position decision and statistics of the current version. A green status means “the process runs and its data is fresh” — not a risk grade and not approval for real money.
      </p>
    </section>

    <section class="grid gap-5 md:grid-cols-3 pb-10">
      {tiers.map((t) => {
        const c = toneMap[t.tone];
        return (
          <div class={`rounded-2xl border ${c.border} ${c.bg} p-6 flex flex-col`}>
            {/* M10p2: card FACE reads as one glance — name, ONE number, ONE status chip, and the
                mandatory tail (⚠ never hidden — honesty floor). Secondary detail (what it is, the
                full caveat, evidence provenance) collapses into "Full risk sheet" so the three tiers
                are scannable instead of a wall of 6 lines each. */}
            {/* ADR-537: one card format on every surface — status, real-capital admission, mechanic,
                position, the current version's result (same definition for all three), maturity, risk,
                freshness, then the research target as a secondary line with its research tail next to
                it. The target band no longer sits where a result belongs. */}
            <div class="flex items-center justify-between mb-3">
              <h2 class="text-xl font-bold text-white" data-ru={t.ru}>{t.en}</h2>
            </div>
            <PackageStatusRows pkg={t.key} part="status" />
            <PackageStatusRows pkg={t.key} part="live" />
            <p class="text-[11px] font-mono text-slate-400 -mt-2 mb-4"><span data-ru="Исследовательский ярлык:">Research label:</span> <span data-ru={t.status_ru}>{t.status_en}</span></p>
            <PackageStatusRows pkg={t.key} part="body" />
            {t.key !== 'conservative' && (
              <div class="text-xs font-mono text-slate-400 mb-4 pb-3 border-b border-white/10" data-ru={t.tail_ru}>⚠ {t.tail_en}</div>
            )}
            {t.prefix_en && (
              <div class="text-xs font-mono text-amber-300/90 -mt-2 mb-4" data-ru={t.prefix_ru}>
                ⚠ {t.prefix_en}
              </div>
            )}
            {t.caveat_en && (
              <div class="text-xs font-mono text-amber-300/90 -mt-2 mb-4" data-ru={t.caveat_ru}>
                ⚠ {t.caveat_en}
              </div>
            )}
            <details class="group mt-auto">
              <summary class="cursor-pointer list-none text-sm font-medium text-accent-400 select-none flex items-center gap-1.5">
                <span class="transition-transform group-open:rotate-90" aria-hidden="true">▸</span>
                <span data-ru="Полный риск-лист">Full risk sheet</span>
              </summary>
              <div class="pt-4">
                <p class="text-xs font-mono text-slate-400 mb-3"><span data-ru="Целевой диапазон исследования:">Research target band:</span> <span data-ru={t.band_ru}>{t.band_en}</span></p>
                <p class="text-sm text-slate-400 leading-relaxed mb-4" data-ru={t.what_ru}>{t.what_en}</p>
                <p class="text-sm text-slate-300 leading-relaxed mb-4" data-ru={t.caveat_ru}>{t.caveat_en}</p>
                <span class="inline-block max-w-full text-[10px] font-mono px-2 py-0.5 rounded bg-white/[0.06] text-slate-400" style="overflow-wrap:anywhere" data-ru={t.evidence_ru}>{t.evidence_en}</span>
              </div>
            </details>
          </div>
        );
      })}
    </section>

    <!-- #50 proof strip — "don't trust us, check us": every tier number is independently verifiable. -->
    <section class="rounded-xl border border-white/10 bg-white/[0.02] px-5 py-4 mb-8">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <span class="text-xs font-mono uppercase tracking-wider text-slate-500" data-ru="Не верьте на слово — проверьте">Don't trust us — check us</span>
        <a href="/track-record" data-track="packages_proof_track_record" class="text-sm text-accent-400 underline" data-ru="Живой трек →">Live track record →</a>
        <a href="/refusals" data-track="packages_proof_refusals" class="text-sm text-accent-400 underline" data-ru="Журнал отказов →">Refusal log →</a>
        <a href="/exit-nav" data-track="packages_proof_exit_nav" class="text-sm text-accent-400 underline" data-ru="Ликвидационный NAV по размеру →">Liquidation-NAV by size →</a>
      </div>
    </section>

    <section class="rounded-2xl border border-white/10 bg-white/[0.02] p-6 mb-8">
      <h3 class="text-lg font-semibold text-white mb-3" data-ru="Как тир становится доступным">How a tier becomes available</h3>
      <p class="text-sm text-slate-400 leading-relaxed mb-3" data-ru="Пакет предлагается клиенту ТОЛЬКО когда его стратегии прошли DSR-гейт на реальных данных + полный Yield-Lab-цикл (yield-source → протокол → ликвидность → риск → Red Team → paper-тест → одобрение человека). Сейчас Conservative — реальный и подтверждённый; Balanced и Aggressive — research/paper, показаны с хвостом, для live НЕ аллоцируются.">
        A package is offered ONLY when its strategies pass the DSR gate on real data + the full Yield-Lab lifecycle (yield-source → protocol → liquidity → risk → Red Team → paper test → human approval). Today Conservative is real and evidenced; Balanced and Aggressive are research/paper, shown with the tail, and are NOT live-allocated.
      </p>
      <div class="flex flex-wrap gap-3 mt-4">
        <a href="/annual-contrast" data-track="packages_to_annual_contrast" class="text-sm text-accent-400 underline" data-ru={`Хвост в цифрах: 15% против фактических бумажных ~${rrRu}${rrNoteRu} →`}>The tail in numbers: 15% vs the realized paper ~{rrEn}{rrNoteEn} →</a>
        <a href="/monitoring" data-track="packages_to_monitoring" class="text-sm text-accent-400 underline" data-ru="Живой мониторинг риска →">Live risk monitoring →</a>
        <a href="/status" data-track="packages_to_status" class="text-sm text-accent-400 underline" data-ru="Живой трек и go-live →">Live track & go-live →</a>
      </div>
    </section>

    <section class="rounded-2xl border border-accent-500/20 bg-accent-500/[0.04] p-6 mb-8">
      <h3 class="text-lg font-semibold text-white mb-2" data-ru="Дальше — честный разговор">Next — an honest conversation</h3>
      <p class="text-sm text-slate-400 leading-relaxed mb-4" data-ru="Если консервативный, подтверждённый трек вам близок — это не оферта, а черновик для разговора с дизайн-партнёром. Некастодиально, human-in-the-loop.">
        If the conservative, evidenced track fits how you allocate — this is not an offer, it is a draft for a conversation with a design partner. Non-custodial, human-in-the-loop.
      </p>
      <a href="/pilot" data-track="packages_to_pilot" class="inline-flex items-center gap-2 text-sm font-semibold text-accent-400 underline" data-ru="Пилот с дизайн-партнёром →">Design-partner pilot →</a>
    </section>

    <!-- C8: reusable trust band — same four honest pillars on every conversion surface. -->
    <div class="mb-8"><TrustBand /></div>

    <p class="text-xs text-slate-500 leading-relaxed" data-ru="Paper / advisory. Balanced и Aggressive — outside RiskPolicy, никогда не аллоцируются live, не трогают go-live трек. Целевые диапазоны — исследовательские цели, а не результаты; результат пакета показывается на его карточке только для текущей версии стратегии и только после 30 валидных дней. Никогда не подаём бумагу или бэктест как реальный результат.">
      Paper / advisory. Balanced and Aggressive are outside RiskPolicy, never live-allocated, and never touch the go-live track. Target bands are research targets, not results; a package's result is shown on its card only for the current strategy version and only after 30 valid days. We never present paper/backtest as live.
    </p>
  </main>
  <Disclaimer />

  <script is:inline>
    (function () {
      function apply() {
        var ru; try { ru = (localStorage.getItem('spa_lang') || 'en') !== 'en'; } catch (e) { ru = false; }
        document.querySelectorAll('[data-ru]').forEach(function (el) {
          var r = el.getAttribute('data-ru');
          if (!el.hasAttribute('data-en')) el.setAttribute('data-en', el.textContent);
          el.textContent = ru ? r : el.getAttribute('data-en');
        });
      }
      apply();
      window.addEventListener('storage', apply);
      document.addEventListener('spa:lang', apply);
    })();
  </script>
</Layout>
