---
// Risk — PRODUCT-UX-01 candidate. Plain language first, detail second, no numeric risk score.
// Stop thresholds render from lib/constitution.json via lib/profile_view.js — never typed here.
import Layout from '../layouts/Layout.astro';
import UxStyles from '../components/ux/UxStyles.astro';
import RiskList from '../components/ux/RiskList.astro';
import { PROFILES, profileView, GO_LIVE } from '../lib/profile_view.js';
import '../lib/constitution.json';
const views = PROFILES.map(profileView);
---
<Layout title="Risk — what can go wrong, in plain words | Earn DeFi"
        description="The main risks of Earn DeFi's three paper strategies, ranked and explained in plain language, with the stop rules that apply to each."
        canonical="https://earn-defi.com/risk">
  <UxStyles />
  <main id="main-content">
    <section class="ux-section">
      <div class="ux-wrap">
        <p class="ux-eyebrow" data-ru="Риск">Risk</p>
        <h1 class="ux-h1" data-ru="Что может пойти не так">What can go wrong</h1>
        <p class="ux-lead" data-ru="Риск нельзя убрать — его можно назвать, ограничить и показать. Ниже главное, по убыванию значимости. Баллов риска мы не ставим: точной цифры для этого нет.">Risk cannot be removed — it can be named, limited and shown. Below are the main risks, most important first. We do not give risk scores: there is no honest number for that.</p>
      </div>
    </section>

    <section class="ux-section">
      <div class="ux-wrap">
        <h2 class="ux-h2" data-ru="Главные риски">The main risks</h2>
        <RiskList />
      </div>
    </section>

    <section class="ux-section">
      <div class="ux-wrap">
        <h2 class="ux-h2" data-ru="Как ограничен каждый портфель">How each portfolio is limited</h2>
        <div class="ux-grid3">
          {views.map((v) => (
            <div class="ux-card">
              <h3 class="ux-h3" data-ru={v.name_ru}>{v.name_en}</h3>
              <span class:list={['ux-tag', `risk-${v.risk_tone}`]} data-ru={`риск: ${v.risk_ru.toLowerCase()}`}>risk: {v.risk_en.toLowerCase()}</span>
              <p class="ux-p" style="margin-top:10px" data-ru={v.stop.ru}>{v.stop.en}</p>
              <p class="ux-small" data-ru={v.liquidity_ru}>{v.liquidity_en}</p>
            </div>
          ))}
        </div>
        <p class="ux-small" style="margin-top:14px" data-ru={GO_LIVE.ru}>{GO_LIVE.en}</p>
      </div>
    </section>

    <section class="ux-section">
      <div class="ux-wrap">
        <h2 class="ux-h2" data-ru="Подробнее">Go deeper</h2>
        <div class="ux-btnrow">
          <a class="ux-btn" href="/protection-lab/" data-ru="Кризисы прошлого через нашу защиту">Past crises replayed</a>
          <a class="ux-btn" href="/risk-disclosure/" data-ru="Полное раскрытие рисков">Full risk disclosure</a>
          <a class="ux-btn" href="/disclaimer/" data-ru="Отказ от ответственности">Disclaimer</a>
        </div>
        <p class="ux-small" style="margin-top:18px" data-ru="Не оферта и не инвестиционный совет. Доходность переменная и не гарантирована; возможна потеря средств.">Not an offer or investment advice. Returns are variable and not guaranteed; loss of funds is possible.</p>
      </div>
    </section>
  </main>
</Layout>
