---
import Layout from '../layouts/Layout.astro';
import snap from '../data/track_snapshot.json';
import { goLiveLabel, gateClosedOn } from '../lib/golive_label.js';

// Shows current system status: GoLive score, paper trading progress.
// SSR values are the last committed evidenced SNAPSHOT (data/golive_status.json +
// data/equity_curve_daily.json, derived into src/data/track_snapshot.json — NOT
// hand-typed literals that silently drift). The page then fetches LIVE values from
// api.earn-defi.com client-side and overrides the snapshot; if the API is offline,
// the honest snapshot stands and the page says so. The day count is the HONEST
// evidenced count (we reset the track — only cycle-logged days count; earlier days
// were flat-rate backfill). Anchor 2026-06-22. See /track-record.
const goLiveChecks = snap.gates_passed != null ? snap.gates_passed : '—';
const goLiveTotal = snap.gates_total != null ? snap.gates_total : '—';
const goLiveReadinessPct = Math.round((goLiveChecks / goLiveTotal) * 100);
const evidenceDays = snap.real_track_days != null ? snap.real_track_days : '—';  // evidenced days — ONE source, no hardcode (FIX-2)
const evidenceTarget = snap.days_needed != null ? snap.days_needed : '—';    // 30 honest days required (ADR-002)
// Go-live wording — ONE honest source (src/lib/golive_label.js). snap.go_live_target is the gate's
// calendar ETA (anchor + 29 d = 2026-07-21) and it has passed; a date is shown only while it is
// still ahead of snap.as_of, otherwise "decision pending — gate passed, date not set". No literal.
const goLive = goLiveLabel(snap);
const trackStart = snap.evidenced_anchor ?? "2026-06-22";  // evidence anchor (NOT backfilled 06-10)
const trackGatePassed = goLive.gatePassed;
const gatesKnown = snap.gates_passed != null && snap.gates_total != null;
const gatesAllPass = gatesKnown && Number(snap.gates_passed) >= Number(snap.gates_total);
const gateClosed = gateClosedOn(snap);  // date the 30th evidenced day was logged (from the snapshot's own bars)

// Blockers — derived from the SAME snapshot the 29/29 card reads (data/golive_status.json →
// track_snapshot.json), never a hand-typed list (the old literal said "2 blockers remaining" at
// 77/30 evidenced days while golive_status.blockers was []). The only blockers this page has ever
// carried are the two time-gated ones: open while the evidenced day-count is below the target,
// moved to the "passed" history once it is reached. Any other failing criterion is named by count.
const timeGated = [
  { name: 'min_track_days_30', en: 'evidenced track days', ru: 'подтверждённых дней трека' },
  { name: 'gap_monitor_30d', en: 'evidenced track days, continuity', ru: 'подтверждённых дней трека, непрерывность' },
];
const blockers = [
  ...(trackGatePassed ? [] : timeGated.map(t => `${t.name} — ${evidenceDays}/${evidenceTarget} ${t.en} (time-gated)`)),
  ...((gatesKnown && !gatesAllPass) ? [`${Number(snap.gates_total) - Number(snap.gates_passed)} GoLiveChecker criteria not passing — see /dashboard → GoLiveChecker`] : []),
];
const passedHistory = trackGatePassed ? timeGated.map(t => ({ ...t, detail: `${evidenceDays}/${evidenceTarget}` })) : [];
const blockerCount = blockers.length;
const blockersEn = (n) => n === 0 ? 'no open blockers' : `${n} blocker${n === 1 ? '' : 's'} remaining`;
const blockersRu = (n) => n === 0 ? 'открытых блокеров нет' : `осталось ${n} ${n === 1 ? 'блокер' : (n < 5 ? 'блокера' : 'блокеров')}`;

type CheckStatus = "pass" | "warn" | "fail";

const checks: { label: string; labelRu: string; status: CheckStatus; detail: string }[] = [
  { label: "GoLive Criteria", labelRu: "Критерии GoLive", status: gatesAllPass ? "pass" : "warn", detail: `${goLiveChecks}/${goLiveTotal} checks pass — ${blockersEn(blockerCount)}` },
  { label: "Paper Track Record", labelRu: "Track record бумажной торговли", status: trackGatePassed ? "pass" : "warn", detail: trackGatePassed ? `${evidenceDays}/${evidenceTarget} evidenced days · anchor ${trackStart} · ${evidenceTarget}-day gate passed${gateClosed ? ' on ' + gateClosed : ''}` : `${evidenceDays}/${evidenceTarget} evidenced days · anchor ${trackStart} (${goLive.en})` },
  { label: "Daily Cycle (launchd)", labelRu: "Ежедневный цикл (launchd)", status: "pass", detail: "com.spa.daily_cycle running at 06:00 UTC" },
  { label: "HTTP API", labelRu: "HTTP API", status: "pass", detail: "com.spa.apiserver on port 8765 (FastAPI, api.earn-defi.com)" },
  { label: "Cloudflare Tunnel", labelRu: "Cloudflare Tunnel", status: "pass", detail: "com.spa.cloudflared active" },
  { label: "Risk Policy Gate", labelRu: "Риск-гейт", status: "pass", detail: "RiskPolicy v1.0 — deterministic, LLM forbidden" },
  { label: "Adapter Health", labelRu: "Здоровье адаптеров", status: "pass", detail: "Aave V3, Compound V3, Morpho Steakhouse — all responding" },
  { label: "Auto-Push (GitHub)", labelRu: "Auto-Push (GitHub)", status: "pass", detail: "com.spa.autopush installed — pushes every 90 min" },
];

const statusColor: Record<CheckStatus, string> = {
  pass: "text-ok",
  warn: "text-warn",
  fail: "text-danger",
};
const statusIcon: Record<CheckStatus, string> = {
  pass: "✅",
  warn: "⚠️",
  fail: "❌",
};
const statusBg: Record<CheckStatus, string> = {
  pass: "border-ok-border bg-ok-bg",
  warn: "border-warn-border bg-warn-bg",
  fail: "border-danger-border bg-danger-bg",
};
---

<Layout
  title="System Status — SPA earn-defi.com"
  description="Live operational status of the SPA autonomous DeFi yield optimizer. GoLive criteria, paper track record progress, infrastructure health. Live from api.earn-defi.com, with an honest snapshot fallback when offline."
>
  <main class="min-h-screen bg-bg text-white font-sans">

    <!-- Header -->
    <div class="max-w-4xl mx-auto px-6 py-12 space-y-10">

      <!-- Hero status banner -->
      <div class="rounded-2xl border border-warn-border bg-warn-bg p-8">
        <div class="flex items-start gap-4">
          <div class="text-3xl mt-1">⚠️</div>
          <div>
            <h1 class="text-2xl font-bold text-warn mb-2" data-ru="В ПРОЦЕССЕ — фаза бумажной торговли">IN PROGRESS — Paper Trading Phase</h1>
            <p class="text-white/60 leading-relaxed">
              <span data-ru="SPA сейчас работает в проверяемом режиме бумажной торговли с виртуальным капиталом $100,000 USDC. Перевод на реальный капитал:">SPA is currently in verified paper trading mode with virtual capital of $100,000 USDC.
              Go-live transfer to real capital:</span> <strong class="text-white" data-ru={goLive.ru}>{goLive.en}</strong> <span data-ru="— после ручного review владельца.">— after a manual Owner review.</span>
            </p>
          </div>
        </div>
      </div>

      <!-- Two main metrics -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

        <!-- GoLive Readiness -->
        <div class="rounded-xl border border-white/10 bg-white/5 p-6">
          <div class="text-sm text-white/55 uppercase tracking-wider mb-3" data-ru="Готовность к GoLive">GoLive Readiness</div>
          <div class="flex items-end gap-2 mb-3">
            <span class="text-5xl font-bold text-warn" id="st-gates-pass">{goLiveChecks}</span>
            <span class="text-2xl text-white/50 mb-1">/ <span id="st-gates-total">{goLiveTotal}</span></span>
          </div>
          <!-- Progress bar -->
          <div class="h-2 bg-white/10 rounded-full overflow-hidden mb-2">
            <div
              id="st-gates-bar"
              class="h-full bg-warn rounded-full transition-all"
              style={`width: ${goLiveReadinessPct}%`}
            ></div>
          </div>
          <p class="text-white/50 text-sm"><span id="st-gates-pct">{goLiveReadinessPct}</span><span data-ru={`% критериев пройдено — ${blockersRu(blockerCount)}`}>% criteria pass — {blockersEn(blockerCount)}</span></p>
        </div>

        <!-- Paper Track Record -->
        <div class="rounded-xl border border-white/10 bg-white/5 p-6">
          <div class="text-sm text-white/55 uppercase tracking-wider mb-3" data-ru="Честный track record">Honest Track Record</div>
          <div class="flex items-end gap-2 mb-3">
            <span class="text-5xl font-bold text-blue-400" id="st-days">{evidenceDays}</span>
            <span class="text-2xl text-white/50 mb-1">/ {evidenceTarget} <span data-ru="дней">days</span></span>
          </div>
          <!-- Progress bar -->
          <div class="h-2 bg-white/10 rounded-full overflow-hidden mb-2">
            <div
              id="st-days-bar"
              class="h-full bg-blue-400 rounded-full transition-all"
              style={`width: ${Math.round(evidenceDays / evidenceTarget * 100)}%`}
            ></div>
          </div>
          <p class="text-white/50 text-sm"><span data-ru="Реальный трек начат">Real track started</span> {trackStart} <span data-ru="(демо-данные исключены)">(demo data excluded)</span></p>
        </div>

      </div>

      <!-- Blockers — from the snapshot (see frontmatter), never a hand-typed list -->
      {blockers.length > 0 ? (
        <div class="rounded-xl border border-danger-border bg-danger-bg p-6">
          <h2 class="text-danger font-semibold text-lg mb-4" data-ru="⛔ Активные блокеры">⛔ Active Blockers</h2>
          <ul class="space-y-2">
            {blockers.map(b => (
              <li class="flex items-start gap-3 text-white/70 text-sm">
                <span class="text-danger mt-0.5 shrink-0">•</span>
                <code class="font-mono text-danger text-xs bg-danger px-2 py-1 rounded">{b}</code>
              </li>
            ))}
          </ul>
        </div>
      ) : (
        <div class="rounded-xl border border-ok-border bg-ok-bg p-6">
          <h2 class="text-ok font-semibold text-lg mb-4" data-ru="✅ Активных блокеров нет">✅ Active blockers: none</h2>
          {passedHistory.length > 0 && (
            <ul class="space-y-2">
              {passedHistory.map(t => (
                <li class="flex items-start gap-3 text-white/70 text-sm">
                  <span class="text-ok mt-0.5 shrink-0">•</span>
                  <code class="font-mono text-ok text-xs bg-white/5 px-2 py-1 rounded">{t.name} — {t.detail} <span data-ru={t.ru}>{t.en}</span> · <span data-ru="пройден">passed</span></code>
                </li>
              ))}
            </ul>
          )}
        </div>
      )}

      <!-- Component status checks -->
      <div>
        <h2 class="text-white font-semibold text-xl mb-4" data-ru="Проверки инфраструктуры">Infrastructure Checks</h2>
        <div class="space-y-3">
          {checks.map(c => (
            <div class={`rounded-xl border px-5 py-4 flex items-start gap-4 ${statusBg[c.status]}`}>
              <span class="text-xl shrink-0 mt-0.5">{statusIcon[c.status]}</span>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-medium text-white" data-ru={c.labelRu}>{c.label}</span>
                  <span class={`text-xs font-semibold uppercase ${statusColor[c.status]}`}>
                    {c.status}
                  </span>
                </div>
                <p class="text-white/50 text-sm mt-0.5">{c.detail}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Timeline -->
      <div class="rounded-xl border border-white/10 bg-white/5 p-6">
        <h2 class="text-white font-semibold text-lg mb-6" data-ru="Таймлайн Go-Live">Go-Live Timeline</h2>
        <div class="relative pl-6">
          <div class="absolute left-0 top-2 bottom-2 w-px bg-white/10"></div>
          <div class="space-y-6">
            <div class="relative">
              <div class="absolute -left-6 top-1 w-3 h-3 rounded-full bg-ok ring-2 ring-ok-border"></div>
              <div class="text-ok text-sm font-semibold">2026-06-22</div>
              <div class="text-white/70 text-sm mt-0.5" data-ru="Трек сброшен и заякорен на первом дне с реальным логом цикла. Ранний бэкфилл по фиксированной ставке не засчитывается.">Track reset, anchored to the first day with a real cycle log. Earlier flat-rate backfill is not counted.</div>
            </div>
            <div class="relative">
              <div class={`absolute -left-6 top-1 w-3 h-3 rounded-full ${trackGatePassed ? 'bg-ok ring-2 ring-ok-border' : 'bg-warn ring-2 ring-warn-border'}`}></div>
              <div class={`${trackGatePassed ? 'text-ok' : 'text-warn'} text-sm font-semibold`}>{trackGatePassed ? (gateClosed ?? '—') : '—'} <span data-ru={trackGatePassed ? '(факт)' : '(ожидается)'}>{trackGatePassed ? '(reached)' : '(pending)'}</span></div>
              <div class="text-white/70 text-sm mt-0.5" data-ru={`${evidenceTarget} подтверждённых дней завершены — временной порог (min_track_days_30 / gap_monitor_30d) выполнен`}>{evidenceTarget} evidenced days complete — the time gate (min_track_days_30 / gap_monitor_30d) satisfied</div>
            </div>
            <div class="relative">
              <div class="absolute -left-6 top-1 w-3 h-3 rounded-full bg-blue-400 ring-2 ring-blue-400/30"></div>
              <div class="text-blue-400 text-sm font-semibold" data-ru="ожидается">pending</div>
              <div class="text-white/70 text-sm mt-0.5" data-ru="Ручной review владельца (ADR-002) — решение владельца, не календарная дата">Manual Owner review (ADR-002) — an owner decision, not a calendar item</div>
            </div>
            <div class="relative">
              <div class="absolute -left-6 top-1 w-3 h-3 rounded-full bg-white/20 ring-2 ring-white/10"></div>
              <div class="text-white/55 text-sm font-semibold" data-ru={goLive.shortRu}>{goLive.shortEn}</div>
              <div class="text-white/55 text-sm mt-0.5" data-ru="Go-live: ввод реального капитала после подтверждённого верифицированного трека в 30 дней">Go-live: real capital deployment after confirmed 30-day verified track</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Footer note — honest source label (live-or-snapshot, never a false "updated daily" claim) -->
      <div class="text-center text-white/50 text-sm pb-4">
        <p>
          <span data-ru="Источник:">Source:</span>
          <span id="st-src" class="font-mono text-white/55" data-ru="последний подтверждённый снимок">last evidenced snapshot</span>
          <span class="text-white/25">·</span>
          <span data-ru="Живые значения загружаются из api.earn-defi.com; при офлайне показывается последний подтверждённый снимок.">Live values load from api.earn-defi.com; the last evidenced snapshot is shown when the API is offline.</span>
        </p>
        <p class="mt-1">
          <a data-track="status_to_due_diligence" href="/due-diligence" class="text-white/50 hover:text-white transition-colors underline underline-offset-2" data-ru="Центр Due Diligence">Due Diligence Center</a>
          &nbsp;·&nbsp;
          <a href="/risk-disclosure" class="text-white/50 hover:text-white transition-colors underline underline-offset-2" data-ru="Раскрытие рисков">Risk Disclosure</a>
          &nbsp;·&nbsp;
          <a href="/" class="text-white/50 hover:text-white transition-colors underline underline-offset-2" data-ru="Главная">Home</a>
        </p>
      </div>

    </div>
  </main>

  <script is:inline>
    /* Live status — api.earn-defi.com (localhost fallback), graceful offline.
     * On success the SSR snapshot numbers are overridden with live values and the
     * source label flips to "live". On failure the honest snapshot stands and the
     * label keeps saying "last evidenced snapshot" — never a false "updated daily" claim. */
    (function(){
      var API = (location.hostname === 'localhost' || location.hostname === '127.0.0.1')
        ? 'http://localhost:8765'
        : 'https://api.earn-defi.com';
      var DAYS_NEEDED = 30;
      function setText(id, txt){ var el = document.getElementById(id); if(el){ el.textContent = txt; } }
      function setWidth(id, pct){ var el = document.getElementById(id); if(el){ el.style.width = Math.max(0, Math.min(100, pct)) + '%'; } }
      function isRu(){ try{ return (localStorage.getItem('spa_lang') || 'en') === 'ru'; }catch(e){ return false; } }

      function loadGoLive(){
        fetch(API + '/api/v1/golive').then(function(r){ return r.json(); }).then(function(d){
          if(!d) return;
          var days = d.real_track_days != null ? d.real_track_days : null;
          var pass = d.passed != null ? d.passed : d.risk_gates_passed;
          var total = d.total != null ? d.total : d.risk_gates_total;
          if(days != null){
            setText('st-days', days);
            setWidth('st-days-bar', (days / DAYS_NEEDED) * 100);
          }
          if(pass != null){ setText('st-gates-pass', pass); }
          if(total != null){ setText('st-gates-total', total); }
          if(pass != null && total != null){
            var pct = Math.round((pass / total) * 100);
            setText('st-gates-pct', pct);
            setWidth('st-gates-bar', pct);
          }
          // Flip the source label to "live" only once we actually have live data.
          var src = document.getElementById('st-src');
          if(src){
            src.textContent = isRu() ? 'api.earn-defi.com (вживую)' : 'api.earn-defi.com (live)';
            src.removeAttribute('data-ru');
          }
        }).catch(function(){ /* offline → SSR snapshot + honest label stand */ });
      }

      function init(){ loadGoLive(); }
      if(document.readyState === 'loading'){ document.addEventListener('DOMContentLoaded', init); }
      else { init(); }
    })();
  </script>
</Layout>
