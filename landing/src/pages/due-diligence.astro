---
import Layout from '../layouts/Layout.astro';
import snap from '../lib/snapshot_view.js';
import { goLiveLabel } from '../lib/golive_label.js';
import { profileView, maturityShort } from '../lib/profile_view.js';
import { drawdownMagnitudeText, usdCents, shortDate, rateReconciliation, totalReturnSinceStart } from '../lib/realized_rate.js';
import NUMBERS, { fmtPct2, threshold } from '../lib/site_numbers.js';

// Build-time offline fallback (auto-generated by scripts/generate_track_snapshot.py
// from data/golive_status.json + data/equity_curve_daily.json — never hand-edited).
// The inline script below overrides this live from /api/v1/golive on any real visit.
const realDays = snap.real_track_days != null ? snap.real_track_days : '—';  // ONE source, no hardcode (FIX-2)
const goLive = goLiveLabel(snap);  // go-live wording — date only while still ahead of snap.as_of; the old '~Jul 21, 2026' was the gate's calendar ETA
// Strategy status — from the canonical card model (profile_view.js → package_card.js), never
// hand-typed: the old table had the maturity INVERTED (P1 2026-10-08: «Balanced — paper tracked
// since 22 Jun», «Conservative — planned», while Conservative is the one with the measured track).
const STATUS_ROWS = ['conservative', 'balanced', 'aggressive'].map((k) => {
  const v = profileView(k); const s = maturityShort(k);
  return { key: k, name_en: v.name_en, name_ru: v.name_ru, mature: v.maturity.state === 'MATURE', st_en: s.en, st_ru: s.ru };
});
// Largest drawdown on the track — from the shelf (same figure as /track-record), not «0%».
const _dd = drawdownMagnitudeText(NUMBERS && NUMBERS.headline && NUMBERS.headline.drawdown && NUMBERS.headline.drawdown.value);
// What the book holds — from the shelf's `exposure` (← track_snapshot.book_exposure ← current_positions.json +
// ADAPTER_REGISTRY). Not measured ⇒ null ⇒ the page says so; never a hand-typed list (P1 2026-10-08).
const _ex = NUMBERS && NUMBERS.exposure;
const _usd = (f, ru) => (f && typeof f.value === 'number') ? usdCents(f.value, ru) : '—';
const _sh = (f, ru) => (f && typeof f.value === 'number') ? fmtPct2(f.value, ru) : '—';
const _tier = (t, ru) => t === 'unlabelled' ? (ru ? 'без метки' : 'unlabelled') : t === 'unresolved' ? (ru ? 'не определён' : 'unresolved') : t;
const EXPO = (_ex && _ex.state === 'MEASURED' && Array.isArray(_ex.rows)) ? {
  asOfEn: shortDate(_ex.as_of, false) || '—', asOfRu: shortDate(_ex.as_of, true) || '—',
  baseEn: _usd(_ex.base_usd, false), baseRu: _usd(_ex.base_usd, true),
  cashEn: _usd(_ex.cash, false), cashRu: _usd(_ex.cash, true),
  cashShareEn: _sh(_ex.cash_share, false), cashShareRu: _sh(_ex.cash_share, true),
  rows: _ex.rows.map((r) => ({ protocol: r.protocol, tier: r.tier, tierEn: _tier(r.tier, false), tierRu: _tier(r.tier, true),
    usdEn: _usd(r.usd, false), usdRu: _usd(r.usd, true), shareEn: _sh(r.share, false), shareRu: _sh(r.share, true) })),
} : null;
// Thresholds from the constitution (decision values), formatted by the one formatter (ADR-660).
const _soft = threshold('kill_switch_soft'), _hard = threshold('kill_switch_hard');
const softEn = _soft && typeof _soft.value === 'number' ? fmtPct2(-Math.abs(_soft.value), false) : '—';
const softRu = _soft && typeof _soft.value === 'number' ? fmtPct2(-Math.abs(_soft.value), true) : '—';
const hardEn = _hard && typeof _hard.value === 'number' ? fmtPct2(-Math.abs(_hard.value), false) : '—';
const hardRu = _hard && typeof _hard.value === 'number' ? fmtPct2(-Math.abs(_hard.value), true) : '—';
const ddEn = _dd != null ? fmtPct2(-Math.abs(Number(NUMBERS.headline.drawdown.value)), false) : null;
const ddRu = _dd != null ? fmtPct2(-Math.abs(Number(NUMBERS.headline.drawdown.value)), true) : null;
const recEn = rateReconciliation(false), recRu = rateReconciliation(true);
const totEn = totalReturnSinceStart(false).text, totRu = totalReturnSinceStart(true).text;
---

<Layout
  title="Methodology &amp; Evidence — SPA earn-defi.com"
  description="Methodology and evidence journal for SPA. Current status, live data links, protocol whitelist, audit status, and documentation."
  canonical="https://earn-defi.com/due-diligence"
>

  <!-- Nav -->
  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-16">

    <!-- Header -->
    <div class="mb-12">
      <p class="text-xs text-accent-400 font-mono uppercase tracking-widest mb-3" data-ru="Слой доказательств">Proof Layer</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4" data-ru="Методология и доказательства">Methodology &amp; Evidence</h1>
      <p class="text-white/50 text-lg leading-relaxed" data-ru="Методология и журнал доказательств для SPA.">
        Methodology and evidence journal for SPA.
      </p>
    </div>

    <!-- Current Status -->
    <section class="mb-14">
      <h2 class="text-xl font-semibold text-white mb-6 pb-3 border-b border-border" data-ru="Текущий статус">Current Status</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="rounded-lg border border-border-strong bg-bg-surface p-4 text-center">
          <p class="text-xs text-white/50 font-mono mb-1" data-ru="Режим">Mode</p>
          <p class="text-sm text-warn font-medium" data-ru="Paper trading">Paper Trading</p>
        </div>
        <div class="rounded-lg border border-border-strong bg-bg-surface p-4 text-center">
          <p class="text-xs text-white/50 font-mono mb-1" data-ru="Капитал (виртуальный)">Capital (virtual)</p>
          <p class="text-sm text-white/70 font-medium">{(threshold('start_capital') && typeof threshold('start_capital').value === 'number') ? usdCents(threshold('start_capital').value).replace('.00', '') + ' USDC' : '—'}</p>
        </div>
        <div class="rounded-lg border border-border-strong bg-bg-surface p-4 text-center">
          <p class="text-xs text-white/50 font-mono mb-1" data-ru="Якорь трека">Track anchor</p>
          <p class="text-sm text-white/70 font-medium" data-ru={shortDate(NUMBERS.headline && NUMBERS.headline.evidenced_anchor, true) || '—'}>{shortDate(NUMBERS.headline && NUMBERS.headline.evidenced_anchor, false) || '—'}</p>
        </div>
        <div class="rounded-lg border border-border-strong bg-bg-surface p-4 text-center">
          <p class="text-xs text-white/50 font-mono mb-1">Go-Live</p>
          <p class="text-sm text-white/70 font-medium" data-ru={goLive.shortRu}>{goLive.shortEn}</p>
        </div>
      </div>
      <div class="mt-4 rounded-lg border border-ok-border bg-ok-bg p-4 flex items-center justify-between">
        <div>
          <p class="text-sm text-white/70">GoLiveChecker</p>
          <p class="text-xs text-white/55" data-ru="Автоматические критерии готовности">Automated readiness criteria</p>
        </div>
        <span class="text-sm font-mono text-ok" data-ru={`${snap.gates_passed}/${snap.gates_total} пройдено · реальный капитал не открыт`}>{snap.gates_passed}/{snap.gates_total} passing · live capital not open</span>
      </div>
    </section>

    {(recEn || totEn) && (
    <section class="mb-14 -mt-8">
      {recEn && <p class="text-xs text-white/55 leading-relaxed" data-ru={`Ставка трека: ${recRu}.`}>Track rate: {recEn}.</p>}
      {totEn && <p class="text-xs text-white/55 leading-relaxed mt-2" data-ru={`Совокупная доходность — другая база: ${totRu}.`}>Total return has a different base: {totEn}.</p>}
    </section>
    )}

    <!-- Verify us yourself (Q2-8) — the full "don't trust us, check us" chain, no manual ask -->
    <section class="mb-14">
      <h2 class="text-xl font-semibold text-white mb-6 pb-3 border-b border-border" data-ru="Проверьте нас сами">Verify Us Yourself</h2>
      <p class="text-sm text-white/60 leading-relaxed mb-5" data-ru="Не верьте нам на слово. Два детерминированных, zero-dependency скрипта воспроизводят всё, что мы публикуем — на нашем публичном data/. Exit 0 или скрипт называет точную сломанную строку.">
        Don't take our word for anything. Two deterministic, zero-dependency scripts reproduce everything we publish, from our public <code>data/</code>. Exit 0 — or the script names the exact broken row.
      </p>
      <div class="rounded-xl border border-border-strong bg-bg-surface p-5 mb-4">
        <p class="text-xs text-accent-400 font-mono uppercase tracking-wider mb-2" data-ru="1. Цепочка доказательств цела">1 · Proof chain is intact</p>
        <pre class="text-xs font-mono text-white/70 overflow-x-auto mb-2">python3 scripts/verify_spa.py data/</pre>
        <p class="text-xs text-white/55 leading-relaxed" data-ru="Покрывает все 7 поверхностей: decision-chain, exit-NAV, anchors, equity-track, tournament, RWA-NAV, sleeves. Точный --expect-head и SHA-256 самого верификатора — в живом DD-паке (auto-generated, guarded).">Covers all 7 surfaces — decision chain, exit-NAV, anchors, equity track, tournament, RWA-NAV, sleeves. The exact <code>--expect-head</code> fingerprint and the verifier's own SHA-256 live in the auto-generated, test-guarded DD pack (<code>docs/DD_PACK.md</code>).</p>
      </div>
      <div class="rounded-xl border border-border-strong bg-bg-surface p-5 mb-4">
        <p class="text-xs text-accent-400 font-mono uppercase tracking-wider mb-2" data-ru="2. Защиты доказуемо срабатывают">2 · The safety machinery FIRES</p>
        <pre class="text-xs font-mono text-white/70 overflow-x-auto mb-2">python3 scripts/defenses_exercised_report.py</pre>
        <p class="text-xs text-white/55 leading-relaxed" data-ru={`11/11 защит срабатывают через тот же governance-код, что и дневной цикл: двухуровневый стоп-кран (SOFT ${softRu} — снижение риска / HARD ${hardRu} — всё в кэш), мягкий уровень блокирует любые новые позиции и увеличения. ` + (ddRu != null ? `Наибольшая просадка трека — ${ddRu}, далеко от мягкого порога ${softRu}: тормоза не срабатывали, потому что не штормило, а не потому что их нет.` : `Просадка трека сейчас не измерена.`)}>11/11 defenses fire through the <b>same</b> governance code the daily cycle uses: two-tier kill ladder (SOFT {softEn} de-risk / HARD {hardEn} all-cash), soft de-risk blocks every NEW position and INCREASE. {ddEn != null ? `The largest drawdown on the track is ${ddEn}, far from the ${softEn} soft threshold — the brakes have not fired because it never stressed, not because they're absent.` : `The track drawdown is not measured right now.`}</p>
      </div>
      <p class="text-xs text-white/55 leading-relaxed" data-ru="Живые публичные поверхности:">Live public surfaces:
        <a href="/readiness" data-track="dd_to_readiness" class="text-accent-400 hover:underline">/readiness</a> ·
        <a href="/refusals" data-track="dd_to_refusals" class="text-accent-400 hover:underline">/refusals</a> ·
        <a href="/exit-nav" data-track="dd_to_exitnav" class="text-accent-400 hover:underline">/exit-nav</a> ·
        <a href="/proof-of-reserves" data-track="dd_to_por" class="text-accent-400 hover:underline">/proof-of-reserves</a> ·
        <a href="/track-record" data-track="dd_to_trackrecord" class="text-accent-400 hover:underline">/track-record</a> ·
        <a href="/fundability" data-track="dd_to_fundability" class="text-accent-400 hover:underline">/fundability</a>
      </p>
    </section>

    <!-- Strategy Status -->
    <section class="mb-14">
      <h2 class="text-xl font-semibold text-white mb-6 pb-3 border-b border-border" data-ru="Статус стратегий">Strategy Status</h2>
      <div class="overflow-x-auto rounded-xl border border-border-strong">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-border-strong bg-bg-surface">
              <th class="text-left text-white/55 font-mono text-xs p-3" data-ru="Стратегия">Strategy</th>
              <th class="text-left text-white/55 font-mono text-xs p-3" data-ru="Статус">Status</th>
              <th class="text-left text-white/55 font-mono text-xs p-3" data-ru="Paper-трекинг">Paper Tracking</th>
            </tr>
          </thead>
          <tbody class="text-white/55">
            {STATUS_ROWS.map((r, i) => (
              <tr class={i < STATUS_ROWS.length - 1 ? 'border-b border-border' : ''}>
                <td class="p-3 text-white/70 font-medium" data-ru={r.name_ru}>{r.name_en}</td>
                <td class="p-3"><span class={r.mature ? 'text-xs font-mono text-ok bg-ok-bg px-2 py-0.5 rounded' : 'text-xs font-mono text-white/55 bg-bg-surface-2 px-2 py-0.5 rounded'} data-ru={r.mature ? 'Бумажный трек' : 'Бумажный тест'}>{r.mature ? 'Paper track' : 'Paper test'}</span></td>
                <td class="p-3 text-white/60" data-ru={r.st_ru}>{r.st_en}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Live Data Links -->
    <section class="mb-14">
      <h2 class="text-xl font-semibold text-white mb-6 pb-3 border-b border-border" data-ru="Ссылки на живые данные">Live Data Links</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a href="/dashboard" class="rounded-xl border border-border-strong bg-bg-surface p-5 hover:border-ok-border transition-colors group">
          <p class="text-sm font-semibold text-white/80 group-hover:text-white mb-1" data-ru="Дашборд">Dashboard</p>
          <p class="text-xs text-white/55" data-ru="Показатели модельного (бумажного) трека: дни трека, ставка, просадка">Simulated paper metrics: track days, rate, drawdown</p>
        </a>
        <a href="/refusals" class="rounded-xl border border-border-strong bg-bg-surface p-5 hover:border-ok-border transition-colors group">
          <p class="text-sm font-semibold text-white/80 group-hover:text-white mb-1" data-ru="Блокировки риска">Risk Blocks</p>
          <p class="text-xs text-white/55" data-ru="Все заблокированные ребалансировки залогированы и с временными метками">All blocked rebalances logged and timestamped</p>
        </a>
        <a href="/track-record" class="rounded-xl border border-border-strong bg-bg-surface p-5 hover:border-ok-border transition-colors group">
          <p class="text-sm font-semibold text-white/80 group-hover:text-white mb-1" data-ru="Логи сделок">Trade Logs</p>
          <p class="text-xs text-white/55" data-ru="Каждый цикл залогирован с обоснованием">Every cycle logged with reasoning</p>
        </a>
        <a href="/readiness" class="rounded-xl border border-border-strong bg-bg-surface p-5 hover:border-ok-border transition-colors group">
          <p class="text-sm font-semibold text-white/80 group-hover:text-white mb-1">GoLiveChecker</p>
          <p class="text-xs text-white/55" data-ru={`${snap.gates_passed}/${snap.gates_total} критериев пройдено · реальный капитал не открыт: нужно решение владельца и юридическая проверка`}>{snap.gates_passed}/{snap.gates_total} criteria passing · live capital not open: needs an owner decision and a legal review</p>
        </a>
      </div>
    </section>

    <!-- Documentation -->
    <section class="mb-14">
      <h2 class="text-xl font-semibold text-white mb-6 pb-3 border-b border-border" data-ru="Документация">Documentation</h2>
      <div class="space-y-3">
        <a href="/trust" class="flex items-center justify-between rounded-lg border border-border-strong bg-bg-surface p-4 hover:border-ok-border transition-colors group">
          <div>
            <p class="text-sm text-white/80 group-hover:text-white" data-ru="Архитектура доверия">Trust Architecture</p>
            <p class="text-xs text-white/55" data-ru="Модель контроля, кастоди, 9 ключевых вопросов">Control model, custody, 9 key questions</p>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-white/20 group-hover:text-ok">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
          </svg>
        </a>
        <a href="/risk" class="flex items-center justify-between rounded-lg border border-border-strong bg-bg-surface p-4 hover:border-ok-border transition-colors group">
          <div>
            <p class="text-sm text-white/80 group-hover:text-white" data-ru="Риск">Risk</p>
            <p class="text-xs text-white/55" data-ru="Категории, матрица, стресс-сценарии">Categories, matrix, stress scenarios</p>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-white/20 group-hover:text-ok">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
          </svg>
        </a>
        <a href="/risk-disclosure" class="flex items-center justify-between rounded-lg border border-border-strong bg-bg-surface p-4 hover:border-ok-border transition-colors group">
          <div>
            <p class="text-sm text-white/80 group-hover:text-white" data-ru="Раскрытие рисков">Risk Disclosure</p>
            <p class="text-xs text-white/55" data-ru="Полное юридическое раскрытие">Full legal disclosure</p>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-white/20 group-hover:text-ok">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
          </svg>
        </a>
        <a href="/security" class="flex items-center justify-between rounded-lg border border-border bg-bg-surface p-4 group hover:border-ok/40 transition-colors">
          <div>
            <p class="text-sm text-white/70" data-ru="Базовая безопасность">Security Baseline</p>
            <p class="text-xs text-white/55" data-ru="Security-обзор + pre-live чеклист">Security review + pre-live checklist</p>
          </div>
          <span class="text-white/20 group-hover:text-ok" aria-hidden="true">→</span>
        </a>
        <a href="/emergency-withdrawal" class="flex items-center justify-between rounded-lg border border-border bg-bg-surface p-4 group hover:border-ok/40 transition-colors">
          <div>
            <p class="text-sm text-white/70" data-ru="Экстренный вывод">Emergency Withdrawal</p>
            <p class="text-xs text-white/55" data-ru="Путь экстренного вывода + kill-switch">Emergency-withdrawal path + kill-switch ladder</p>
          </div>
          <span class="text-white/20 group-hover:text-ok" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- Book exposure — generated, not typed (P1 2026-10-08). The hand-maintained «Protocol Whitelist»
         that stood here contradicted the book: it lacked fluid_fusdc and maple (20 % of the book each),
         labelled Morpho T1 where the registry says T2 and printed undated TVL guesses. The rows below come
         from the cycle's positions snapshot + the canonical ADAPTER_REGISTRY tiers, through the shelf. -->
    <section class="mb-14">
      <h2 class="text-xl font-semibold text-white mb-3 pb-3 border-b border-border" data-ru="Что держит книга">What the book holds</h2>
      {EXPO ? (
        <>
          <p class="text-xs text-white/55 leading-relaxed mb-4"
             data-ru={`Консервативная книга (бумага) на ${EXPO.asOfRu}. Доля — от распределённого бумажного капитала ${EXPO.baseRu} (позиции + кэш). Уровень — из канонического реестра протоколов; это то, что книга держит, а не рекомендация. Полный допустимый перечень и потолки — RiskPolicy v1.0.`}>
            Conservative book (paper) as of {EXPO.asOfEn}. Share of allocated paper capital {EXPO.baseEn} (positions + cash). Tier is from the canonical protocol registry; this is what the book holds, not a recommendation. The full eligible universe and caps are RiskPolicy v1.0.
          </p>
          <div class="overflow-x-auto rounded-xl border border-border-strong">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-border-strong bg-bg-surface">
                  <th class="text-left text-white/55 font-mono text-xs p-3" data-ru="Протокол (id реестра)">Protocol (registry id)</th>
                  <th class="text-left text-white/55 font-mono text-xs p-3" data-ru="Уровень">Tier</th>
                  <th class="text-right text-white/55 font-mono text-xs p-3" data-ru="Сумма">Amount</th>
                  <th class="text-right text-white/55 font-mono text-xs p-3" data-ru="Доля">Share</th>
                </tr>
              </thead>
              <tbody class="text-white/60">
                {EXPO.rows.map((r) => (
                  <tr class="border-b border-border">
                    <td class="p-3 font-mono text-white/75">{r.protocol}</td>
                    <td class="p-3"><span class={r.tier === 'T1' ? 'text-xs font-mono text-ok' : 'text-xs font-mono text-warn'} data-ru={r.tierRu}>{r.tierEn}</span></td>
                    <td class="p-3 text-right font-mono" data-ru={r.usdRu}>{r.usdEn}</td>
                    <td class="p-3 text-right font-mono" data-ru={r.shareRu}>{r.shareEn}</td>
                  </tr>
                ))}
                <tr>
                  <td class="p-3 font-mono text-white/75" data-ru="кэш">cash</td>
                  <td class="p-3 text-xs font-mono text-white/50">—</td>
                  <td class="p-3 text-right font-mono" data-ru={EXPO.cashRu}>{EXPO.cashEn}</td>
                  <td class="p-3 text-right font-mono" data-ru={EXPO.cashShareRu}>{EXPO.cashShareEn}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </>
      ) : (
        <p class="text-sm text-white/55" data-ru="Состав книги сейчас не измерен — таблицу не показываем, а не показываем устаревшую.">The book composition is not measured right now — no table is shown rather than a stale one.</p>
      )}
    </section>

    <!-- Audit & Review Status -->
    <section class="mb-14">
      <h2 class="text-xl font-semibold text-white mb-6 pb-3 border-b border-border" data-ru="Статус аудита и ревью">Audit &amp; Review Status</h2>
      <div class="space-y-4">
        <div class="flex items-center gap-4 rounded-lg border border-border-strong bg-bg-surface p-4">
          <span class="flex-shrink-0 w-2 h-2 rounded-full bg-white/20"></span>
          <div>
            <p class="text-sm text-white/70" data-ru="Аудиты смарт-контрактов">Smart contract audits</p>
            <p class="text-xs text-white/55" data-ru="Пока неприменимо (этап paper trading, нет live-контрактов)">Not yet applicable (paper trading phase, no live contracts)</p>
          </div>
