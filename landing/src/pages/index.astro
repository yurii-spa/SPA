---
// Homepage — PRODUCT-UX-01 candidate. Five sections, product first:
//   (a) what Earn DeFi is + the one measured result (shelf, typed, dated)
//   (b) the three strategies with identical rows
//   (c) how to read the numbers (realized · target · backtest · observed)
//   (d) the main risks in plain words
//   (e) why you can check it, and what to do next
// Every figure comes from lib/profile_view.js → lib/site_numbers.js / realized_rate.js (the weekly shelf)
// and the daily snapshot; nothing is typed here. No calculator, no sign-up: the product is in paper stage.
import Layout from '../layouts/Layout.astro';
import UxStyles from '../components/ux/UxStyles.astro';
import MetricStack from '../components/ux/MetricStack.astro';
import ProfileCompare from '../components/ux/ProfileCompare.astro';
import NumberTypes from '../components/ux/NumberTypes.astro';
import RiskList from '../components/ux/RiskList.astro';
import TrustBlock from '../components/ux/TrustBlock.astro';
import { headline, GO_LIVE, matureProfiles, TIER_NAMES } from '../lib/profile_view.js';
import '../lib/realized_rate.js';
const h = headline();
const lead = matureProfiles()[0] || 'conservative';   // the profile with a published result (derived)
const nMature = matureProfiles().length;
---
<Layout title="Earn DeFi — stablecoin yield research where every number shows its evidence"
        description="Earn DeFi measures stablecoin yield strategies on paper and publishes every number with its type, date and source. Paper stage: no deposits, not an offer.">
  <UxStyles />
  <main id="main-content">
    <section class="ux-section" style="padding-top:28px">
      <div class="ux-wrap">
        <p class="ux-eyebrow">Earn DeFi</p>
        <h1 class="ux-h1" data-ru="Исследование доходности стейблкоинов, где у каждой цифры есть доказательство">Stablecoin yield research where every number shows its evidence</h1>
        <p class="ux-lead" data-ru="Earn DeFi держит три стратегии на стейблкоинах в симуляции и публикует, что они реально заработали — с датой, источником и рисками. Деньги не принимаются: это бумажная стадия.">Earn DeFi runs three stablecoin strategies in simulation and publishes what they actually earned — with the date, the source and the risks. No money is accepted: this is the paper stage.</p>
        <div class="ux-card" style="margin-top:6px">
          <p class="ux-small" style="margin:0 0 10px"
             data-ru={nMature === 1 ? `${TIER_NAMES[lead].ru} — пока единственная стратегия, у которой накопилось достаточно дней для результата` : `${TIER_NAMES[lead].ru} — результат`}>
            {nMature === 1 ? `${TIER_NAMES[lead].en} — so far the only strategy with enough days for a published result` : `${TIER_NAMES[lead].en} — result`}
          </p>
          <MetricStack profile={lead} compact />
        </div>
        <div class="ux-btnrow">
          <a class="ux-btn primary" href="/strategies/" data-ru="Сравнить стратегии">Compare strategies</a>
          <a class="ux-btn" href="/track-record/" data-ru="Результаты по дням">Day-by-day results</a>
        </div>
      </div>
    </section>

    <section class="ux-section">
      <div class="ux-wrap">
        <p class="ux-eyebrow" data-ru="Три стратегии">Three strategies</p>
        <h2 class="ux-h2" data-ru="Одинаковые вопросы к каждой">The same questions for each</h2>
        <ProfileCompare compact />
        <p class="ux-small" style="margin-top:14px" data-ru={GO_LIVE.ru}>{GO_LIVE.en}</p>
      </div>
    </section>

    <section class="ux-section">
      <div class="ux-wrap">
        <p class="ux-eyebrow" data-ru="Как мы измеряем">How we measure</p>
        <h2 class="ux-h2" data-ru="Четыре вида чисел — и они не смешиваются">Four kinds of number — never mixed</h2>
        <NumberTypes />
        <p class="ux-small" style="margin-top:12px"
           data-ru={`Опубликовано ${h.published ?? '—'}, следующее обновление ${h.next ?? '—'}. Цифры обновляются раз в неделю.`}>
          Published {h.published ?? '—'}, next update {h.next ?? '—'}. Figures update weekly.
        </p>
      </div>
    </section>

    <section class="ux-section">
      <div class="ux-wrap">
        <p class="ux-eyebrow" data-ru="Риск">Risk</p>
        <h2 class="ux-h2" data-ru="Что может пойти не так — главное">What can go wrong — the main points</h2>
        <RiskList limit={4} />
        <div class="ux-btnrow"><a class="ux-btn" href="/risk/" data-ru="Все риски простыми словами">All risks in plain words</a></div>
      </div>
    </section>

    <section class="ux-section">
      <div class="ux-wrap">
        <p class="ux-eyebrow" data-ru="Доверие">Trust</p>
        <h2 class="ux-h2" data-ru="Не верьте нам — проверьте">Don't take our word — check</h2>
        <TrustBlock />
        <div class="ux-btnrow">
          <a class="ux-btn primary" href="/track-record/" data-ru="Смотреть результаты по дням">See the day-by-day track</a>
          <a class="ux-btn" href="/how-it-works/" data-ru="Как это устроено">How it works</a>
          <a class="ux-btn" href="/dashboard/" data-ru="Бумажный дашборд">Paper dashboard</a>
        </div>
        <p class="ux-small" style="margin-top:18px" data-ru="Не оферта и не инвестиционный совет. Доходность переменная и не гарантирована; возможна потеря средств. Бумажные результаты — не результаты реальных клиентов.">Not an offer or investment advice. Returns are variable and not guaranteed; loss of funds is possible. Paper results are not real client results.</p>
      </div>
    </section>
  </main>
</Layout>
