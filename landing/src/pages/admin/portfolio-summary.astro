---
// /admin/portfolio-summary — SPA CIO oversight, phase B (docs/ideas/2026-08-29-cio-oversight-layer.md).
// Read-only combined view across the three INDEPENDENT paper-trading books (Conservative/Balanced/
// Aggressive). Does NOT move capital, does NOT blend risk/mandate between books — each book keeps
// its own seed, limits and kill-switch; this page only sums for the overview number. Live from
// /api/live/books (poll ~20s). admin={true} -> noindex/nofollow + slim operator bar. Fail-safe: API
// offline shows "офлайн" honestly, never a fabricated number.
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Operator · Portfolio Summary" admin={true}>
  <main class="ps"><div class="ps-wrap">
    <h1 class="ps-h1">Portfolio Summary</h1>
    <p class="ps-sub">Сводка по трём <b>независимым</b> paper-книгам — Conservative, Balanced, Aggressive. Каждая держит свой капитал, лимиты и kill-switch; здесь только сумма для общей картины, риск между книгами не смешивается. Живые данные из <code>/api/live/books</code> (обновление ~20с). Если API офлайн — честно «офлайн», ничего не выдумываем.</p>

    <!-- Combined KPI bar -->
    <div class="ps-bar">
      <div class="ps-kpi"><div class="k">Всего капитала</div><div class="v" id="ps-total-seed">—</div></div>
      <div class="ps-kpi"><div class="k">Текущий NAV</div><div class="v" id="ps-total-equity">—</div></div>
      <div class="ps-kpi"><div class="k">Общая доходность</div><div class="v" id="ps-total-return">—</div></div>
      <div class="ps-kpi"><div class="k">Книг доступно</div><div class="v" id="ps-avail">—</div></div>
    </div>
    <div class="ps-meta"><span id="ps-state">загрузка…</span> · <span id="ps-gen"></span></div>

    <div class="ps-sec-h">По книгам</div>
    <div class="ps-grid" id="ps-grid"></div>

    <div class="ps-offline" id="ps-offline" hidden>API офлайн — сводка сейчас недоступна. Ничего не выдумываем; повтор через 20с.</div>
  </div></main>
</Layout>

<script is:inline>
  (function(){
    var API=(location.hostname==='localhost'||location.hostname==='127.0.0.1')?'http://localhost:8765':'https://api.earn-defi.com';
    function esc(s){return String(s==null?'':s).replace(/[&<>]/g,function(c){return{'&':'&lt;','>':'&gt;','&':'&amp;'}[c]||c;});}
    function fmtUsd(n){return (n==null)?'—':'$'+Number(n).toLocaleString('en-US',{maximumFractionDigits:0});}
    function fmtPct(n){return (n==null)?'—':(n>=0?'+':'')+Number(n).toFixed(2)+'%';}
    function pctTone(n){return n==null?'muted':n>=0?'ok':'bad';}
    function setOffline(off){document.getElementById('ps-offline').hidden=!off;document.getElementById('ps-state').textContent=off?'офлайн':'онлайн';}

    async function jget(path){var r=await fetch(API+path,{cache:'no-store'});if(!r.ok)throw 0;return r.json();}

    var BOOK_ORDER=[['conservative','Conservative'],['balanced','Balanced'],['aggressive','Aggressive']];

    function renderGrid(books){
      var grid=document.getElementById('ps-grid');grid.innerHTML='';
      BOOK_ORDER.forEach(function(pair){
        var key=pair[0],fallbackLabel=pair[1];
        var b=books[key]||{available:false};
        var card=document.createElement('div');
        card.className='ps-card'+(b.available?'':' off');
        if(!b.available){
          card.innerHTML='<div class="ps-card-h"><span class="nm">'+esc(fallbackLabel)+'</span><span class="p muted">нет данных</span></div>'+
            '<div class="ps-card-d">'+esc(b.reason||'недоступно')+'</div>';
        } else {
          card.innerHTML='<div class="ps-card-h"><span class="nm">'+esc(b.label||fallbackLabel)+'</span><span class="p '+pctTone(b.return_pct)+'">'+fmtPct(b.return_pct)+'</span></div>'+
            '<div class="ps-row"><span class="l">Капитал</span><span>'+fmtUsd(b.seed_equity)+'</span></div>'+
            '<div class="ps-row"><span class="l">NAV сейчас</span><span>'+fmtUsd(b.equity)+'</span></div>'+
            '<div class="ps-row"><span class="l">Годовых (расч.)</span><span>'+fmtPct(b.annualized_apy_pct)+'</span></div>'+
            '<div class="ps-row"><span class="l">С</span><span class="mut">'+esc(b.start_date||'—')+'</span></div>';
        }
        grid.appendChild(card);
      });
    }

    async function tick(){
      try{
        var data=await jget('/api/live/books');
        setOffline(false);
        var c=data.combined||{};
        document.getElementById('ps-total-seed').textContent=fmtUsd(c.total_seed_usd);
        document.getElementById('ps-total-equity').textContent=fmtUsd(c.total_equity_usd);
        var retEl=document.getElementById('ps-total-return');
        retEl.textContent=fmtPct(c.combined_return_pct);
        retEl.parentElement.className='ps-kpi '+pctTone(c.combined_return_pct);
        document.getElementById('ps-avail').textContent=(c.books_available||0)+' из '+(c.books_total||3);
        renderGrid(data.books||{});
        document.getElementById('ps-gen').textContent='обновлено '+new Date().toLocaleTimeString();
      }catch(e){setOffline(true);}
    }
    tick();setInterval(tick,20000);
  })();
</script>

<style is:global>
  /* is:global — the per-book cards are created client-side via innerHTML
     (renderGrid() below), so Astro's compile-time scoping attribute never
     reaches them; a scoped <style> would silently leave .ps-card borderless.
     Class names below (ps-*) are unique to this page. */
  .ps{padding:32px 0 64px}.ps-wrap{max-width:1000px;margin:0 auto;padding:0 24px}
  .ps-h1{font-size:1.6rem;font-weight:700;margin-bottom:8px}
  .ps-sub{color:var(--text-muted,#8a8f98);font-size:.9rem;line-height:1.5;margin-bottom:24px;max-width:820px}
  .ps-bar{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:10px}
  .ps-kpi{background:var(--bg-surface,#16181d);border:1px solid var(--border,#26282e);border-radius:10px;padding:14px}
  .ps-kpi .k{font-size:.7rem;text-transform:uppercase;letter-spacing:.06em;color:var(--text-faint,#6a6f78)}
  .ps-kpi .v{font-size:1.25rem;font-weight:700;font-family:var(--font-mono,monospace);margin-top:4px}
  .ps-kpi.ok .v{color:#34d399}.ps-kpi.bad .v{color:#f87171}.ps-kpi.muted .v{color:#8a8f98}
  .ps-meta{font-size:.75rem;color:var(--text-faint,#6a6f78);margin-bottom:20px}
  .ps-sec-h{font-size:.9rem;font-weight:600;margin-bottom:12px}
  .ps-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}
  .ps-card{background:var(--bg-surface,#16181d);border:1px solid var(--border,#26282e);border-radius:10px;padding:14px}
  .ps-card.off{opacity:.55}
  .ps-card-h{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:10px}
  .ps-card-h .nm{font-weight:600;font-size:.9rem;font-family:var(--font-mono,monospace)}
  .ps-row{display:flex;justify-content:space-between;gap:10px;padding:4px 0;font-size:.82rem;border-bottom:1px solid var(--border,#26282e)}
  .ps-row:last-child{border-bottom:none}
  .ps-row .l{color:var(--text-faint,#6a6f78)}
  .p{font-family:var(--font-mono,monospace);font-size:.78rem;padding:2px 8px;border-radius:6px}
  .p.ok{background:#34d39918;color:#34d399}.p.bad{background:#f8717118;color:#f87171}.p.muted{background:#8a8f9818;color:#8a8f98}
  .ps-card-d{font-size:.8rem;color:var(--text-muted,#8a8f98)}
  .mut{color:var(--text-faint,#6a6f78)}
  .ps-offline{margin-top:20px;padding:14px;border:1px solid #f8717155;border-radius:10px;color:#f87171;font-size:.85rem}
</style>
