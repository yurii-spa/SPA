# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/

# ─────────────────────────────────────────────────────────────────────────────
# data/ GIT POLICY (P3-3, 2026-06-26)
#
# RUNTIME-ONLY (ignored — transient per-run churn, NEVER canonical, self-created
#   by code if absent; baking these into history is pure noise):
#     - data/*.json, data/**/*.json   → all live state snapshots & per-run reports
#       (incl. data/daily_report_*.json, data/milestones/*, data/daily_summaries/*,
#        data/monthly_reports/*, data/reports/* — all JSON, covered here)
#     - *.db / *.sqlite               → live DBs
#     - data/*.db-journal             → SQLite rollback journals (transient)
#     - data/backups/                 → daily DB backup snapshots
#     - data/*.jsonl                  → append-only runtime audit/hash-chain logs
#                                       (audit_trail.jsonl etc.; self-create on miss)
#
# OWNER-GATED DECISION (LEFT TRACKED ON PURPOSE — do NOT untrack without owner):
#   data/equity_curve_daily.json, data/golive_status.json,
#   data/paper_evidence_history.json are CURRENTLY committed track snapshots that
#   the site static-fallback may rely on. They ARE matched by the data/*.json rule
#   above but remain tracked because they were committed before this rule. Whether
#   the volatile track snapshots should live in git at all (canonical-in-git vs
#   runtime-only) is an OWNER decision — see CLAUDE.md "data/ git policy".
#   These were deliberately NOT `git rm --cached`'d here.
# ─────────────────────────────────────────────────────────────────────────────

# P4-9 funding deep-history cache (RUNTIME-ONLY — explicit per owner-flag): the 5-venue funding
# median is persisted/merged across fetches into these files so the hedged-sleeve + rates-desk
# backtest replay window GROWS beyond a single keyless fetch. It can get large and self-creates
# on first refresh — NEVER commit it (keep it out of git history, like all of data/). Already
# matched by the data/*.json rule below, but pinned here so the policy is explicit.
data/funding_history_cache.json
data/funding_history_cache_*.json

# Data files (runtime, не в git)
data/*.json
data/**/*.json
*.db
*.sqlite
data/*.db-journal
data/backups/
data/*.jsonl
data/**/*.jsonl
logs/*.log
*.log
/tmp/

# Frontend build artifacts
cabinet/dist/
landing/dist/
landing/.astro/

# Auto-generated lockfiles (not committed — managed per-subproject)
package-lock.json

# Backup files
*.bak
*.bak_*
*.tmp

# Verification scratch output
out_*.json

# Push script archives
scripts/archive/

# OS
.DS_Store
.env

# Venv
venv/
.venv/
.venv_test/
.github_pat
.github_config

# Cloudflare — содержит Tunnel Token, не пушить!
scripts/cf_install_token.command

# Executable helper scripts (no secrets but not needed in public repo)
*.command

# Node modules (landing, etc.)
node_modules/
landing/node_modules/

# --- Yield Lab research-layer scaffolding (canonical templates/cards/schemas, NOT runtime state) ---
# These are version-controlled research artifacts, not per-run runtime churn. Track them despite the
# broad data/*.json ignore above.
!data/strategy_cards/
!data/strategy_cards/**
!data/protocol_cards/
!data/protocol_cards/**
!data/stablecoin_cards/
!data/stablecoin_cards/**
!data/research_reports/
!data/research_reports/**
!data/ic_memos/
!data/ic_memos/**
!data/risk_reviews/
!data/risk_reviews/**
!data/red_team_reviews/
!data/red_team_reviews/**
!data/strategy_candidates/
!data/strategy_candidates/**

# P2-8 audit hygiene: never track vendored deps or local Claude settings (search history / tokens)
cabinet/node_modules/
.claude/settings.local.json
.claude/*.local.json

# ENV_SETUP v3 §6 — runtime inbox note archive (not canonical)
inbox/.ingested/

# ENV_SETUP v3 §7.4 — Obsidian per-device vault config (not canonical, device-local)
.obsidian/

# Изолированные рабочие деревья параллельных агентов (создаются на время задачи
# и удаляются сами). Это ЧУЖИЕ чекауты того же репозитория — коммитить их значит
# положить репозиторий внутрь самого себя.
.claude/worktrees/

# ADR-089 п.1 (решение владельца 2026-08-15, прецедент ADR-070.2): ДНЕВНОЙ СРЕЗ
# блокировок риск-гейта. `data/risk_policy_blocks.json` — кольцевой буфер, он
# остаётся runtime-only; срез за день коммитится, потому что дневной отчёт
# ссылает на него владельца, а без git этот артефакт есть только на одной машине.
# Секретов в срезе нет: протоколы, суммы, нарушения политики.
!data/risk_blocks_daily/
!data/risk_blocks_daily/**

# ADR-070 п.2 (решение владельца 2026-08-16 по карточке «Сторож сайта не кладёт в git
# данные, из которых считает числа», вариант 1) + ADR-093 п.3: КАНОН ТРЕКА — ровно те
# ЧЕТЫРЕ файла, из которых `scripts/generate_track_snapshot.py` считает публичный снимок.
# Сторож сайта (`scripts/deploy_site_snapshot.py`) кладёт их в ТОТ ЖЕ коммит, что и
# `landing/src/data/track_snapshot.json`. Без них owner-gate не может пересчитать
# изменившееся число и по fail-CLOSED заворачивает честную ночную доставку, а числа
# сайта нельзя проверить из репозитория (замер: снимок 53 дня / 29 гейтов против
# канона в git от 04.07 — 13 дней / 27 гейтов). Эти файлы и так tracked с давних пор;
# негация делает намерение явным и не даёт им выпасть при переносе/переклоне.
# Список ЗАКРЫТ: остальной `data/` — живой трек, он остаётся runtime-only.
# Состав списка определён ЗАМЕРОМ фактических чтений `build_snapshot`, а не чтением её
# шапки: первая доставка перечислила три файла и пропустила четвёртый (ADR-093 п.3).
# `tier1_packages.json` даёт `packages.*` — net-APY и worst-DD карточек тиров на главной,
# то есть прямо owner-gated класс «числа доходности» (`.claude/rules/site-copy.md`).
!data/golive_status.json
!data/equity_curve_daily.json
!data/paper_trading_status.json
!data/tier1_packages.json
